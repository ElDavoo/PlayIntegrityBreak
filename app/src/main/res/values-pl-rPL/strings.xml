    <string name="settings_clear_uninstalled_app_configs">Usuń konfiguracje odinstalowanych aplikacji</string>
    <string name="settings_clear_uninstalled_app_configs_summary">Ta opcja pozwala utworzyć konfigurację bez pozostałości, ale będziesz musiał ponownie skonfigurować aplikacje po ich ponownej instalacji.</string>
    <string name="settings_no_undone_warning">Ta akcja nie może zostać cofnięta.</string>
