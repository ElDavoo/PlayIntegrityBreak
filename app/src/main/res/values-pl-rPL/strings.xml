    <string name="settings_bypass_risky_package_warning">Pomiń ostrzeżenie o ryzykownych pakietach</string>
    <string name="settings_bypass_risky_package_warning_summary">Zwróć uwagę, że deweloperzy nie ponoszą odpowiedzialności za problemy związane z ryzykownymi pakietami przed ani po włączeniu tej funkcji</string>
