    <!-- About -->
    <string name="about_description">PIB הוא מודול LSPosed המתמקד בחסימת שימוש באפליקציות ב-API של Google Play Integrity.</string>
    <string name="about_how_to_use_title">איך להשתמש במודול הזה</string>
    <string name="about_how_to_use_description_1">הפעל את המודול במנהל Xposed שלך והענק לו את ה-scope של Google Play Store (com.android.vending).\nלאחר מכן עצור בכפייה את Google Play Store.</string>
    <string name="about_how_to_use_description_2">כברירת מחדל, כל האפליקציות חסומות מגישה ל-Google Play Integrity. בחר עבור איזו אפליקציה לאפשר גישה, או אם ברצונך להשתמש בקוד שגיאה מסוים.</string>
