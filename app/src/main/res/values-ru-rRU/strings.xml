    <!-- App settings -->
    <string name="app_enable_intervention">Включить PIB</string>
    <string name="app_enable_intervention_desc">Отключите, чтобы разрешить запросы Play Integrity даже если перехват включён по умолчанию.</string>
    <string name="app_rewrite_integrity_response">Включить синтетические ошибки</string>
    <string name="app_rewrite_integrity_response_desc">Если включено, приложение не будет общаться с Play Integrity и вместо этого получит сгенерированную ошибку.</string>
    <string name="app_deliver_synthetic_response">Доставлять синтетический ответ</string>
    <string name="app_deliver_synthetic_response_desc">Если отключено, приложение вообще не получит ответа. Используйте только для тестирования того, где приложение запрашивает Play Integrity (оно может зависнуть надолго).</string>
    <string name="app_delay_synthetic_response">Задерживать доставку ответа</string>
    <string name="app_delay_synthetic_response_desc">Добавляет случайную задержку от 300 до 2000 мс перед отправкой синтетического обратного вызова. Может предотвратить обнаружение по таймингу?</string>
    <string name="app_rewrite_integrity_error_code">Код ошибки для внедрения</string>
    <string name="app_rewrite_integrity_error_code_desc">Приложение получит этот код ошибки.</string>
