    <!-- About -->
    <string name="about_description">
        PIB 是一个 LSPosed 模块，专注于阻止应用使用 Google Play Integrity API。
    </string>
    <string name="about_how_to_use_title">如何使用此模块</string>
    <string name="about_how_to_use_description_1">在 Xposed 管理器中启用该模块，并授予其 Google Play 商店（com.android.vending）权限范围。\n然后，强制停止 Google Play 商店。</string>
    <string name="about_how_to_use_description_2">默认情况下，所有应用都被阻止访问 Google Play Integrity。选择希望允许访问的应用，或选择要使用的特定错误代码。</string>
