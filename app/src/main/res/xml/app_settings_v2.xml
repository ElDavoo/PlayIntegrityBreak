<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/application">
        <Preference
            android:key="appInfo" />
        <SwitchPreferenceCompat
            android:icon="@drawable/outline_shield_24"
            android:key="enableLogger"
            app:singleLineTitle="false"
            android:title="@string/app_rewrite_integrity_response"
            android:summary="@string/app_rewrite_integrity_response_desc" />
    </PreferenceCategory>

    <PreferenceCategory
        android:dependency="enableLogger"
        android:title="@string/preferences">
        <EditTextPreference
            android:icon="@drawable/outline_bug_report_24"
            android:key="rewriteIntegrityErrorCode"
            android:defaultValue="-8"
            android:dependency="enableLogger"
            app:singleLineTitle="false"
            app:useSimpleSummaryProvider="true"
            android:title="@string/app_rewrite_integrity_error_code"
            android:dialogMessage="@string/app_rewrite_integrity_error_code_desc" />
        <SwitchPreferenceCompat
            android:icon="@drawable/outline_bug_report_24"
            android:key="rewriteIntegrityErrorRemediable"
            android:defaultValue="true"
            android:dependency="enableLogger"
            app:singleLineTitle="false"
            android:title="@string/app_rewrite_integrity_error_remediable"
            android:summary="@string/app_rewrite_integrity_error_remediable_desc" />
    </PreferenceCategory>
</PreferenceScreen>
