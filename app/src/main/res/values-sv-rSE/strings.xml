    <!-- About -->
    <string name="about_description">PIB är en LSPosed-modul som fokuserar på att blockera appar från att använda Google Play Integrity API.</string>
    <string name="about_how_to_use_title">Hur man använder denna modul</string>
    <string name="about_how_to_use_description_1">Aktivera modulen i din Xposed manager och ge den Play Butiks-behörighet (com.android.vending).\nStoppa sedan Google Play Butik.</string>
    <string name="about_how_to_use_description_2">Som standard blockeras alla appar från att få åtkomst till Google Play Integrity. Välj för vilka appar du vill tillåta åtkomst, eller om du vill använda en specifik felkod.</string>
