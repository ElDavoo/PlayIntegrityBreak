    <string name="app_enable_intervention">PIB engedélyezése</string>
    <string name="app_enable_intervention_desc">Kapcsolja ki, hogy engedélyezze a Play Integrity kéréseket akkor is, ha az elfogás alapértelmezés szerint engedélyezett.</string>
    <string name="app_rewrite_integrity_response">Szintetikus hibák engedélyezése</string>
    <string name="app_rewrite_integrity_response_desc">Ha engedélyezve van, az alkalmazás nem kommunikál a Play Integrity szolgáltatással, helyette egy generált hibát kap.</string>
