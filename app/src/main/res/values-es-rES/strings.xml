    <!-- About -->
    <string name="about_description">PIB es un módulo de LSPosed enfocado en bloquear que las apps usen la API de Google Play Integrity.</string>
    <string name="about_how_to_use_title">Cómo usar este módulo</string>
    <string name="about_how_to_use_description_1">Habilita el módulo en tu gestor Xposed y concédele el alcance de Google Play Store (com.android.vending).\nLuego, fuerza la detención de Google Play Store.</string>
    <string name="about_how_to_use_description_2">Por defecto, todas las apps están bloqueadas para acceder a Google Play Integrity. Selecciona para qué app quieres permitir el acceso o si quieres usar un código de error específico.</string>
