    <string name="app_enable_intervention">Habilitar PIB</string>
    <string name="app_enable_intervention_desc">Desactiva para permitir solicitudes a Play Integrity incluso cuando la interceptación está habilitada por defecto.</string>
    <string name="app_rewrite_integrity_response">Activar errores sintéticos</string>
    <string name="app_rewrite_integrity_response_desc">Cuando está activado, la app no se comunicará con Play Integrity y en su lugar recibirá un error generado.</string>
