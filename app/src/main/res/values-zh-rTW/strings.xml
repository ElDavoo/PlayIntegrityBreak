    <!-- About -->
    <string name="about_description">PIB 是一個 LSPosed 模組，專注於阻止應用使用 Google Play Integrity API。</string>
    <string name="about_how_to_use_title">如何使用此模組</string>
    <string name="about_how_to_use_description_1">在 Xposed 管理器中啟用此模組，並授予 Google Play 商店 scope（com.android.vending）。\n接著強制停止 Google Play 商店。</string>
    <string name="about_how_to_use_description_2">預設情況下，所有應用都會被阻止存取 Google Play Integrity。請選擇要允許存取的應用，或選擇使用特定錯誤碼。</string>
