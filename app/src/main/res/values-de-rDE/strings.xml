    <string name="app_enable_intervention">PIB aktivieren</string>
    <string name="app_enable_intervention_desc">Deaktivieren, um Play Integrity-Anfragen zuzulassen, auch wenn Abfangen standardmäßig aktiviert ist.</string>
    <string name="app_rewrite_integrity_response">Synthetische Fehler aktivieren</string>
    <string name="app_rewrite_integrity_response_desc">Wenn aktiviert, kommuniziert die App nicht mit Play Integrity und erhält stattdessen einen generierten Fehler.</string>
    <string name="app_deliver_synthetic_response">Synthetische Antwort liefern</string>
    <string name="app_deliver_synthetic_response_desc">Wenn deaktiviert, erhält die App überhaupt keine Antwort. Nur verwenden, um zu testen, wo die App genau nach Play Integrity fragt (sie wird wahrscheinlich lange hängen).</string>
    <string name="app_delay_synthetic_response">Antwortverzögerung</string>
    <string name="app_delay_synthetic_response_desc">Fügt eine zufällige Verzögerung zwischen 300 und 2000 ms ein, bevor synthetische Callback-Antworten geliefert werden. Kann timing-basierte Erkennung verhindern?</string>
    <string name="app_rewrite_integrity_error_code">Zu injizierender Fehlercode</string>
    <string name="app_rewrite_integrity_error_code_desc">Die App erhält diesen Fehlercode.</string>
