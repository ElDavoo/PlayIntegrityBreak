    <!-- About -->
    <string name="about_description">
        PIB is an LSPosed module focused on blocking apps from using Google Play Integrity API.
    </string>
    <string name="about_how_to_use_title">How to use this module</string>
    <string name="about_how_to_use_description_1">Enable the module in your Xposed manager, and give it the Google Play Store scope (com.android.vending).\nThen, force-stop Google Play Store.</string>
    <string name="about_how_to_use_description_2">By default, all apps are blocked from accessing Google Play Integrity. Select for which app you want to allow access, or if you want to use a specific error code.</string>
