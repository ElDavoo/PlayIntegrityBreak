    <!-- About -->
    <string name="about_description">PIB là một module LSPosed tập trung vào việc chặn ứng dụng sử dụng Google Play Integrity API.</string>
    <string name="about_how_to_use_title">Cách sử dụng module này</string>
    <string name="about_how_to_use_description_1">Bật module trong Xposed manager của bạn, và cấp phạm vi Google Play Store (com.android.vending).\nSau đó, bắt buộc dừng Google Play Store.</string>
    <string name="about_how_to_use_description_2">Mặc định, tất cả ứng dụng bị chặn truy cập Google Play Integrity. Chọn ứng dụng mà bạn muốn cho phép truy cập, hoặc nếu bạn muốn sử dụng một mã lỗi cụ thể.</string>
