    <!-- App settings -->
    <string name="app_enable_intervention">PIBを有効にする</string>
    <string name="app_enable_intervention_desc">無効にすると、介入がデフォルトで有効な場合でもPlay Integrityリクエストが許可されます。</string>
    <string name="app_rewrite_integrity_response">合成エラーを有効にする</string>
    <string name="app_rewrite_integrity_response_desc">有効にすると、アプリはPlay Integrityと通信せず、代わりに生成されたエラーを受け取ります。</string>
    <string name="app_deliver_synthetic_response">合成レスポンスを配信する</string>
    <string name="app_deliver_synthetic_response_desc">無効にすると、アプリはまったくレスポンスを受け取りません。アプリがPlay Integrityを要求する正確な箇所をテストする場合にのみ使用してください（長時間ハングする可能性があります）。</string>
    <string name="app_delay_synthetic_response">レスポンス配信を遅延</string>
    <string name="app_delay_synthetic_response_desc">合成コールバックの配信前に300〜2000msのランダムな遅延を追加します。タイミング検出を防げる可能性があります。</string>
    <string name="app_rewrite_integrity_error_code">注入するエラーコード</string>
    <string name="app_rewrite_integrity_error_code_desc">アプリはこのエラーコードを受け取ります。</string>
    <string name="app_rewrite_integrity_error_code_reference">エラーコード参照</string>
    <string name="app_rewrite_integrity_error_code_reference_desc">可能なエラー値の表を開きます。</string>
    <string name="app_rewrite_integrity_error_remediable">再試行可能フラグ</string>
    <string name="app_rewrite_integrity_error_remediable_desc">リクエストは再試行されるべきであるとアプリに伝えます（例えばエラーが一時的である場合）。</string>
