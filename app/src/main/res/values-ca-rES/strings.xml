    <!-- App settings -->
    <string name="app_enable_intervention">Activa PIB</string>
    <string name="app_enable_intervention_desc">Desactiva per permetre les sol·licituds de Play Integrity encara que la intercepció estigui habilitada per defecte.</string>
    <string name="app_rewrite_integrity_response">Activa errors sintètics</string>
    <string name="app_rewrite_integrity_response_desc">Quan està activat, l\'aplicació no es comunicarà amb Play Integrity i rebrà un error generat.</string>
    <string name="app_deliver_synthetic_response">Enviar resposta sintètica</string>
    <string name="app_deliver_synthetic_response_desc">Quan està desactivat, l\'aplicació no rebrà cap resposta. Utilitza-ho només per provar on exactament l\'aplicació sol·licita Play Integrity (pot quedar-se penjada durant molt de temps).</string>
    <string name="app_delay_synthetic_response">Retardar l\'enviament de la resposta</string>
    <string name="app_delay_synthetic_response_desc">Afegeix un retard aleatori entre 300 i 2000 ms abans d\'entregar les crides de retorn sintètiques. Pot evitar deteccions basades en el temps?</string>
    <string name="app_rewrite_integrity_error_code">Codi d\'error a injectar</string>
    <string name="app_rewrite_integrity_error_code_desc">L\'aplicació rebrà aquest codi d\'error.</string>
    <string name="app_rewrite_integrity_error_code_reference">Referència de codis d\'error</string>
    <string name="app_rewrite_integrity_error_code_reference_desc">Obre una taula amb els possibles valors d\'error.</string>
    <string name="app_rewrite_integrity_error_remediable">Indicador recuperable</string>
    <string name="app_rewrite_integrity_error_remediable_desc">Indica a l\'aplicació que la sol·licitud s\'hauria de reintentar (per exemple, l\'error és temporal).</string>
    <string name="app_rewrite_integrity_error_code_reference_title">Referència de codis d\'error d\'Integrity</string>
