    <!-- About -->
    <string name="about_description">PIB je modul pro LSPosed zaměřený na blokování aplikací používajících API Google Play Integrity.</string>
    <string name="about_how_to_use_title">Jak tento modul používat</string>
    <string name="about_how_to_use_description_1">Povolte modul ve svém Xposed manageru a udělte mu rozsah pro Obchod Google Play (com.android.vending).\nPoté násilně zastavte Obchod Google Play.</string>
    <string name="about_how_to_use_description_2">Ve výchozím nastavení jsou všechny aplikace zablokovány v přístupu k Google Play Integrity. Vyberte, které aplikaci chcete povolit přístup, nebo zda chcete použít konkrétní kód chyby.</string>
