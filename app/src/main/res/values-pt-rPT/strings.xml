    <!-- About -->
    <string name="about_description">PIB é um módulo LSPosed focado em bloquear aplicações de utilizarem a API Google Play Integrity.</string>
    <string name="about_how_to_use_title">Como usar este módulo</string>
    <string name="about_how_to_use_description_1">Ative o módulo no seu gestor Xposed e dê-lhe o âmbito da Google Play Store (com.android.vending).\nDepois, force a paragem da Google Play Store.</string>
    <string name="about_how_to_use_description_2">Por predefinição, todas as aplicações são bloqueadas de aceder ao Google Play Integrity. Seleccione para que aplicação pretende permitir o acesso, ou se pretende usar um código de erro específico.</string>
