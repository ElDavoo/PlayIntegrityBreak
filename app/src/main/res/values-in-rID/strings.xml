    <!-- About -->
    <string name="about_description">PIB adalah modul LSPosed yang berfokus pada memblokir aplikasi dari menggunakan Google Play Integrity API.</string>
    <string name="about_how_to_use_title">Cara menggunakan modul ini</string>
    <string name="about_how_to_use_description_1">Aktifkan modul di Xposed manager Anda, dan beri scope Google Play Store (com.android.vending).\nKemudian, hentikan paksa Google Play Store.</string>
    <string name="about_how_to_use_description_2">Secara default, semua aplikasi diblokir mengakses Google Play Integrity. Pilih aplikasi mana yang ingin Anda izinkan aksesnya, atau jika Anda ingin menggunakan kode error tertentu.</string>
