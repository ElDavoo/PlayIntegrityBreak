    <!-- About -->
    <string name="about_description">PIB er et LSPosed-modul med fokus på at blokere apps fra at bruge Google Play Integrity API.</string>
    <string name="about_how_to_use_title">Sådan bruger du dette modul</string>
    <string name="about_how_to_use_description_1">Aktivér modulet i din Xposed-manager, og giv det Google Play Butik-omfanget (com.android.vending).\nDerefter skal du tvinge stoppe Google Play Butik.</string>
    <string name="about_how_to_use_description_2">Som standard er alle apps blokeret fra at få adgang til Google Play Integrity. Vælg for hvilke apps du vil tillade adgang, eller om du ønsker at bruge en specifik fejlkode.</string>
